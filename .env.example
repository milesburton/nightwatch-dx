# nightwatch-dx configuration
# Copy to .env and fill in your values. .env is gitignored — never commit it.
#
# Usage:
#   cp .env.example .env
#   # edit .env
#   docker compose up -d

# ── Deploy target (used by scripts/deploy.sh) ─────────────────────────────────
# SSH target: user@host
SERVER=miles@192.168.1.211
# Path to the repo on the remote server
REPO=~/nightwatch-dx

# ── RTL-SDR hardware ──────────────────────────────────────────────────────────
# Centre frequency in Hz. With a 125 MHz LO upconverter:
#   139131000 Hz → 14.131 MHz on-air (20m band centre)
RTL_FREQUENCY=139131000
# Sample rate in samples/sec. 1200000 is rock-solid on all RTL-SDR hardware.
RTL_SAMPLE_RATE=1200000
# Gain in tenths of dB (R820T steps: 0,9,14,27,37,77,87,125,144,157,…).
# 77 = 7.7 dB — tuned for 1.2 Msps bandwidth to avoid display saturation.
RTL_GAIN=77

# ── Persistence ───────────────────────────────────────────────────────────────
DB_PATH=/data/nightwatch-dx.db
FRAMES_DIR=/data/frames

# ── Ports (internal, change only if you have conflicts) ───────────────────────
UI_PORT=8080
API_PORT=8900
